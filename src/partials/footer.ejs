<div class="footer">
        <p><%= venue.name %></p>
        <p><%= t(venue.addressKey) %></p>
        <%# Cross-link to the other venue: store → garden always, garden → store once STORE_PUBLIC %>
        <% if (typeof otherVenue !== 'undefined' && otherVenue) { %>
        <p class="footer-venue"><%= t('footer.alsoVisit') %> <a href="<%= base %><%= otherVenue.path %>"><%= otherVenue.name %></a> · <%= t(otherVenue.addressKey) %></p>
        <% } %>
        <p><%- icon('beer') %> <%= t('footer.responsibly') %> <%- icon('beer') %></p>
        <!--! oh wow, you've made it to footer! none of free beers, sry :* -->
        <div class="soc-link">
            <a href="https://t.me/Beersheep" target="_blank" rel="noopener noreferrer" aria-label="Telegram (<%= t('footer.opensNewTab') %>)"><%- icon('telegram') %> Telegram</a>
            <a href="<%= venue.instagram %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram (<%= t('footer.opensNewTab') %>)"><%- icon('instagram') %> Instagram</a>
            <a href="https://www.facebook.com/BeerSheep1/" target="_blank" rel="noopener noreferrer" aria-label="Facebook (<%= t('footer.opensNewTab') %>)"><%- icon('facebook') %> Facebook</a>
        </div>
</div>
