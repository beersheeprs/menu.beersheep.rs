<%
var origin = 'https://menu.beersheep.rs';
var pageKey = pageType === 'bottles' || pageType === 'store' ? pageType : pageType === '404' ? 'notFound' : 'taps';
var pageTitle = t(pageKey + '.title');
var pageDesc = t(pageKey === 'notFound' ? 'taps.desc' : pageKey + '.desc');
var pageUrl = origin + base + pagePath;
var metaKey = pageType === 'store' ? 'store' : 'meta';
%>
<meta name="keywords" content="<%= t(metaKey + '.keywords') %>" />
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="view-transition" content="same-origin">
<title><%= pageTitle %></title>
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:description" content="<%= pageDesc %>">
<meta name="description" content="<%= pageDesc %>">
<meta property="og:url" content="<%= pageUrl %>">
<link rel="canonical" href="<%= pageUrl %>" />
<% var publicLocales = locales.filter(function(l) { return l.public; }); %>
<% if (pageType !== '404' && isPublic && publicLocales.length > 1) { publicLocales.forEach(function(l) { %>
<link rel="alternate" hreflang="<%= l.code %>" href="<%= origin + l.base + pagePath %>" />
<% }) %>
<link rel="alternate" hreflang="x-default" href="<%= origin + pagePath %>" />
<% } %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= t(metaKey + '.siteName') %>">
<meta property="og:locale" content="<%= t('meta.ogLocale') %>">
<meta property="og:image" content="<%= origin %>/og-image.png" />
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Beersheep Garden logo">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= pageTitle %>">
<meta name="twitter:description" content="<%= pageDesc %>">
<meta name="twitter:image" content="<%= origin %>/og-image.png">
<%# Beta design previews (/beta/) must never be indexed, nor their links followed %>
<meta name="robots" content="<%= theme ? 'noindex, nofollow' : isPublic ? 'index, follow' : 'noindex, follow' %>">
<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
<link rel="icon" type="image/png" href="/favicon-196x196.png" sizes="196x196" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="application-name" content="<%= venue.name %>" />
<meta name="theme-color" content="<%= theme ? theme.color : colorScheme[colorScheme.default === 'light' ? 'light' : 'dark'] %>" />
<% if (!theme) { %>
<%# Light/dark scheme (COLOR_SCHEME in build.js): set data-theme before first paint, so there is no
    flash. A saved choice (header switcher) wins, then the default; 'system' follows the device.
    Beta themes skip this: they are designed on the dark colours. %>
<script>
(function(){
  var d = document.documentElement, mode, def = <%- JSON.stringify(colorScheme.default) %>;
  window.colorSchemeDefault = def;
  try { mode = localStorage.getItem('color-scheme'); } catch (e) {}
  if (mode !== 'light' && mode !== 'dark') mode = def === 'light' || def === 'dark' ? def : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  d.dataset.theme = mode;
  window.applyColorScheme = function(m, save){
    d.dataset.theme = m;
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.content = m === 'light' ? '<%= colorScheme.light %>' : '<%= colorScheme.dark %>';
    var b = document.querySelector('.scheme-toggle');
    if (b) b.setAttribute('aria-pressed', m === 'light' ? 'false' : 'true');
    if (save) { try { localStorage.setItem('color-scheme', m); } catch (e) {} }
  };
})();
</script>
<% } %>
<% if (theme) { %>
<%# Beta theme: overrides on top of /styles.css (linked by the page before this partial) %>
<% if (theme.fonts) { %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?<%- theme.fonts %>&display=swap">
<% } %>
<link rel="stylesheet" href="/beta/<%= theme.slug %>.css">
<% } %>
