<%
var origin = 'https://menu.beersheep.rs';
var pageKey = pageType === 'bottles' || pageType === 'store' ? pageType : pageType === '404' ? 'notFound' : 'taps';
var pageTitle = t(pageKey + '.title');
var pageDesc = t(pageKey === 'notFound' ? 'taps.desc' : pageKey + '.desc');
var pageUrl = origin + base + pagePath;
var metaKey = pageType === 'store' ? 'store' : 'meta';
%>
<meta name="keywords" content="<%= t(metaKey + '.keywords') %>" />
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="view-transition" content="same-origin">
<title><%= pageTitle %></title>
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:description" content="<%= pageDesc %>">
<meta name="description" content="<%= pageDesc %>">
<meta property="og:url" content="<%= pageUrl %>">
<link rel="canonical" href="<%= pageUrl %>" />
<% var publicLocales = locales.filter(function(l) { return l.public; }); %>
<% if (pageType !== '404' && isPublic && publicLocales.length > 1) { publicLocales.forEach(function(l) { %>
<link rel="alternate" hreflang="<%= l.code %>" href="<%= origin + l.base + pagePath %>" />
<% }) %>
<link rel="alternate" hreflang="x-default" href="<%= origin + pagePath %>" />
<% } %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= t(metaKey + '.siteName') %>">
<meta property="og:locale" content="<%= t('meta.ogLocale') %>">
<meta property="og:image" content="<%= origin %>/og-image.png" />
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Beersheep Garden logo">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= pageTitle %>">
<meta name="twitter:description" content="<%= pageDesc %>">
<meta name="twitter:image" content="<%= origin %>/og-image.png">
<meta name="robots" content="<%= isPublic ? 'index, follow' : 'noindex, follow' %>">
<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
<link rel="icon" type="image/png" href="/favicon-196x196.png" sizes="196x196" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="application-name" content="<%= venue.name %>" />
<meta name="theme-color" content="#231f20" />
