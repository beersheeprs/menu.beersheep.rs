<%# The Beer Store is a separate venue: its page has no tabs to the garden pages %>
<% if (pageType !== 'store') { %>
<nav class="page-nav" aria-label="<%= t('nav.label') %>">
    <a href="<%= base %>/" class="nav-link<%= pageType === 'taps' ? ' active' : '' %>"><%= t('nav.taps') %></a>
    <a href="<%= base %>/bottles/" class="nav-link<%= pageType === 'bottles' ? ' active' : '' %>"><%= t('nav.bottles') %></a>
    <%# Beer Store tab on the garden pages: only once the store is public %>
    <% if (storePublic) { %>
    <a href="<%= base %>/store/" class="nav-link"><%= t('nav.store') %></a>
    <% } %>
</nav>
<% } %>
<nav class="lang-switch" aria-label="<%= t('nav.language') %>">
    <% locales.forEach(function(l, i) { %><% if (i > 0) { %><span class="lang-sep" aria-hidden="true">/</span><% } %><a href="<%= l.base %><%= pagePath %>" hreflang="<%= l.code %>" lang="<%= l.code %>" class="lang-link<%= l.code === lang ? ' active' : '' %>"<% if (l.code === lang) { %> aria-current="true"<% } %>><%= l.name %></a><% }) %>
</nav>
