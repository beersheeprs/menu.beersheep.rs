<div class="snippet" itemscope itemtype="https://schema.org/MenuItem">
    <% if (item.tap_num) { %><meta itemprop="identifier" content="#tap<%= item.tap_num %>"><% } %>
    <div class="snippet-header">
        <div class="title-row">
            <h2 class="snippet-name" itemprop="name">
                <% if(item.tap_num) { %>
                    <%= item.tap_num %>. <%= item.name %>
                <% } else { %>
                    <%= item.name %>
                <% } %>
            </h2>
            <span class="abv-badge">
                <%= item.abv.toFixed(1) %>% ABV
                <% if(item.ibu) { %>| <%= item.ibu %> IBU<% } %>
            </span>
        </div>
        <div class="snippet-subtitle">
            <div class="producer">
                <%= item.brewery %><% if (item.country) { %>, <%= item.country %><% } %>
            </div>
            <div class="snippet-style">
                <%= item.style %>
                <% if (item.serving_style === 'draft') { %> <i class="fas fa-faucet-drip" aria-hidden="true"></i><% } %>
                <% if (item.serving_style === 'can') { %> <i class="fas fa-jar" aria-hidden="true"></i><% } %>
                <% if (item.serving_style === 'bottle') { %> <i class="fas fa-wine-bottle" aria-hidden="true"></i><% } %>
            </div>
        </div>
    </div>
    <div class="snippet-content">
        <div class="snippet-image">
            <% if(item.image_name){ %>
                <img src="/img/<%= item.image_name %>.webp" alt="<%= item.name %>" itemprop="image" />
            <% } else if (item.image_url) { %>
                <img src="<%= item.image_url %>" alt="<%= item.name %>" itemprop="image" />
            <% } else { %>
                <div class="placeholder"><i class="fas fa-beer" aria-hidden="true"></i></div>
            <% } %>
        </div>
        <div class="snippet-details">
            <% if (item.description) { %>
                <p class="snippet-description" itemprop="description">
                    <%= item.description %>
                </p>
            <% } %>
            <% if(item.rating) { %>
                <div class="circle-rating" style="--rating: <%= item.rating.toFixed(1) %>" aria-label="Rating: <%= item.rating.toFixed(2) %> out of 5" itemscope itemtype="https://schema.org/AggregateRating">
                    <meta itemprop="ratingValue" content="<%= item.rating.toFixed(2) %>">
                    <meta itemprop="bestRating" content="5">
                    <div class="circles">● ● ● ● ●</div>
                    <div><span class="value">
                            <%= item.rating.toFixed(2) %>
                        </span><span class="rating-label">/5</span></div>
                </div>
            <% } %>
        </div>
    </div>
    <div class="snippet-prices">
        <div class="price-option">
            <div class="size-price">
                <% if (item.prices) { %>
                    <% Object.entries(item.prices).forEach(([volume, price]) => { %>
                        <span itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                            <meta itemprop="priceCurrency" content="RSD">
                            <% var v = parseFloat(volume); var label = volume.match(/[lm]/i) ? volume : (v >= 1 ? (v / 1000) + ' l' : volume + ' l'); %>
                            <span class="size"><%= label %>:</span>
                            <span class="price"><data itemprop="price" value="<%= price %>"><%= price %> RSD</data></span>
                        </span>
                    <% }) %>
                <% } else if (item.price_small || item.price_big) { %>
                    <% if(item.price_small) { %>
                        <span itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                            <meta itemprop="priceCurrency" content="RSD">
                            <span class="size">0.33 l:</span>
                            <span class="price"><data itemprop="price" value="<%= item.price_small %>"><%= item.price_small %> RSD</data></span>
                        </span>
                    <% } %>
                    <% if(item.price_big) { %>
                        <span itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                            <meta itemprop="priceCurrency" content="RSD">
                            <span class="size">0.5 l:</span>
                            <span class="price"><data itemprop="price" value="<%= item.price_big %>"><%= item.price_big %> RSD</data></span>
                        </span>
                    <% } %>
                <% } else { %>
                    <span class="size">Please ask the bartender for price details</span>
                <% } %>
            </div>
        </div>
    </div>
</div>
