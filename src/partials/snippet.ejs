<% var isStore = pageType === 'store'; %>
<%# Store items are products for sale, not menu items (matches the store's JSON-LD) %>
<div class="snippet" itemscope itemtype="https://schema.org/<%= isStore ? 'Product' : 'MenuItem' %>"<% if (isStore) { %> data-search="<%= [item.name, item.brewery, item.style].join(' ').toLowerCase() %>" data-group="<%= item.style_group %>"<% } %>>
    <% if (item.tap_num) { %><meta itemprop="identifier" content="#tap<%= item.tap_num %>"><% } %>
    <div class="snippet-header">
        <div class="title-row">
            <h2 class="snippet-name" itemprop="name">
                <% if(item.tap_num) { %>
                    <%= item.tap_num %>. <%= item.name %>
                <% } else { %>
                    <%= item.name %>
                <% } %>
            </h2>
            <% if (item.abv != null) { %>
            <span class="abv-badge">
                <%= item.abv.toFixed(1) %>% ABV
                <% if(item.ibu) { %>| <%= item.ibu %> IBU<% } %>
            </span>
            <% } else if (/^Non-Alcoholic\b/i.test(item.style || '')) { %>
            <%# Untappd shows "N/A ABV" for both 0% and unknown; only the style says non-alcoholic %>
            <span class="abv-badge"><%= t('snippet.nonAlcoholic') %></span>
            <% } %>
        </div>
        <div class="snippet-subtitle">
            <div class="producer">
                <%= item.brewery %><% if (item.country) { %>, <%= localize.country(item.country) %><% } %>
            </div>
            <div class="snippet-style">
                <%= item.style %>
                <%# On the store page each size shows its own container instead %>
                <% if (!isStore) { %>
                <% if (item.serving_style === 'draft') { %> <%- icon('faucet-drip') %><% } %>
                <% if (item.serving_style === 'can') { %> <%- icon('jar') %><% } %>
                <% if (item.serving_style === 'bottle') { %> <%- icon('wine-bottle') %><% } %>
                <% } %>
            </div>
            <% if (item.on_tap) { %>
                <div class="on-tap-badge"><%- icon('faucet-drip') %> <%= t(isStore ? 'snippet.alsoOnTapInGarden' : 'snippet.alsoOnTap') %></div>
            <% } %>
        </div>
    </div>
    <div class="snippet-content">
        <%
           var labelSrc = item.image_thumb || item.image_hd_url || item.image_url;
           var isHd = !!item.image_hd_url;
        %>
        <div class="snippet-image<%= isHd ? ' has-hd' : '' %>">
            <% if (item.untappd_url) { %><a href="<%= item.untappd_url %>" target="_blank" rel="noopener"><% } %>
            <% if (labelSrc) { %>
                <%# The first cards are on screen at load: fetch them first instead of lazily %>
                <img src="<%= labelSrc %>" alt="<%= item.name %>" itemprop="image"
                     <%- typeof eager !== 'undefined' && eager ? 'fetchpriority="high"' : 'loading="lazy"' %> />
            <% } else { %>
                <div class="placeholder"><%- icon('beer') %></div>
            <% } %>
            <% if (item.untappd_url) { %></a><% } %>
        </div>
        <div class="snippet-details">
            <% var description = localize.description(item); %>
            <% if (description) { %>
                <p class="snippet-description" itemprop="description">
                    <%= description %>
                </p>
            <% } %>
            <% if(item.rating) { %>
                <div class="circle-rating" style="--rating: <%= item.rating.toFixed(1) %>" aria-label="<%= t('snippet.rating', { value: item.rating.toFixed(2) }) %>" itemscope itemtype="https://schema.org/AggregateRating">
                    <meta itemprop="ratingValue" content="<%= item.rating.toFixed(2) %>">
                    <meta itemprop="bestRating" content="5">
                    <div class="circles">● ● ● ● ●</div>
                    <div><span class="value">
                            <%= item.rating.toFixed(2) %>
                        </span><span class="rating-label">/5</span></div>
                </div>
            <% } %>
        </div>
    </div>
    <div class="snippet-prices">
        <div class="price-option">
            <div class="size-price">
                <%
                   var validPrices = item.prices && typeof item.prices === 'object'
                     ? Object.entries(item.prices).filter(function(e) { return e[1] > 0; })
                         .sort(function(a, b) { return parseFloat(a[0]) - parseFloat(b[0]); })
                     : [];
                %>
                <% if (validPrices.length > 0) { %>
                    <% validPrices.forEach(function(entry) { var volume = entry[0]; var price = entry[1]; %>
                        <span itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                            <meta itemprop="priceCurrency" content="RSD">
                            <% var v = parseFloat(volume); var label = volume.match(/[lm]/i) ? volume : (v >= 1 ? (v / 1000) + ' l' : volume + ' l'); %>
                            <span class="size"><%= label %>:</span>
                            <span class="price"><data itemprop="price" value="<%= price %>"><%= price %> <%= t('snippet.currency') %></data></span>
                        </span>
                    <% }) %>
                <% } else if (isStore && item.sizes && item.sizes.length > 0) { %>
                    <%# The store lists volumes but no prices; each volume keeps its own container %>
                    <% item.sizes.forEach(function(c) { %>
                        <span class="container-size">
                            <% if (c.style === 'can') { %><%- icon('jar') %><% } %>
                            <% if (c.style === 'bottle') { %><%- icon('wine-bottle') %><% } %>
                            <%= c.size %>
                        </span>
                    <% }) %>
                <% } else if (!isStore) { %>
                    <span class="size"><%= t('snippet.askPrice') %></span>
                <% } %>
            </div>
        </div>
    </div>
</div>
