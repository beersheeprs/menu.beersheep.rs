<!DOCTYPE html>
<html lang="en">

<head>
    <% if (process.env.NODE_ENV==='production' ) { %>
        <%- partials.gtag %>
        <%- partials.cftag %>
    <% } %>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://assets.untappd.com">
    <link rel="stylesheet" href="styles.css" fetchpriority="high">
    <link rel="prefetch" href="/bottles.html" as="document">
    <%- include('partials/head', {pageType}) %>
    <meta property="og:updated_time" content="<%= new Date().toISOString() %>" />
</head>

<body>
    <%- include('partials/scroll-top') %>
    <div class="overlay" aria-hidden="true"
        style="background-color:#333; position:absolute; top:0px; left:0px; width:100%; height:100%; z-index:2000;">
    </div>
    <div class="container">
        <%- include('partials/header', {pageType}) %>
        <%- include('partials/ld-json', {ldJson}) %>
        <main>
            <div class="grid">
                <% if (beers.data && beers.data.length> 0) { %>
                    <% beers.data.forEach(beer=> { %>
                        <%- include('partials/snippet', {item: beer}); %>
                    <% }) %>
                <% } else { %>
                    <p>No beers available at the moment. Please check back later!</p>
                <% } %>
            </div>
        </main>
    </div>
    <%- partials.footer %>
    <div style="display: none;"><%= new Date().toUTCString() %></div>
</body>

</html>