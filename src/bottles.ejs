<!DOCTYPE html>
<html lang="en">

<head>
    <% if (process.env.NODE_ENV==='production' ) { %>
        <%- partials.gtag %>
        <%- partials.cftag %>
    <% } %>
    <link rel="stylesheet" href="styles.css">
    <link rel="prefetch" href="/">
    <%- include('partials/head', {pageType}) %>
    <meta property="og:updated_time" content="<%= new Date().toISOString() %>" />
</head>

<body>
    <div class="scroll-progress"></div>
    <div class="overlay" aria-hidden="true"
        style="background-color:#333; position:absolute; top:0px; left:0px; width:100%; height:100%; z-index:2000;">
    </div>
    <div class="container">
        <%- include('partials/header', {pageType}) %>
        <%- include('partials/ld-json', {ldJson}) %>
        <main>
            <% if (sections && sections.length > 0) { %>
                <%- include('partials/section-nav') %>
                <% sections.forEach(section => { %>
                    <% var slug = section.name.replace(/[^a-zA-Z0-9]/g, '-').replace(/-+/g, '-').toLowerCase(); %>
                    <section class="beer-section" id="<%= slug %>">
                        <h2 class="section-header"><%= section.name %></h2>
                        <div class="grid">
                            <% section.beers.forEach(beer => { %>
                                <%- include('partials/snippet', {item: beer}); %>
                            <% }) %>
                        </div>
                    </section>
                <% }) %>
            <% } else { %>
                <p>No bottled beers available at the moment. Please check back later!</p>
            <% } %>
        </main>
    </div>
    <%- partials.footer %>
    <div style="display: none;"><%= new Date().toUTCString() %></div>
</body>

</html>
