<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <%# Must come first: browsers only look for the charset in the first 1024 bytes %>
    <meta charset="utf-8">
    <% if (process.env.NODE_ENV==='production' ) { %>
        <%- partials.gtag %>
        <%- partials.cftag %>
    <% } %>
    <link rel="preconnect" href="https://assets.untappd.com">
    <link rel="stylesheet" href="/styles.css" fetchpriority="high">
    <link rel="prefetch" href="<%= base %>/" as="document">
    <%- include('partials/head', {pageType}) %>
    <meta property="og:updated_time" content="<%= buildDate.toISOString() %>" />
</head>

<body>
    <%- iconSprite %>
    <%- include('partials/scroll-top') %>
    <div class="overlay" aria-hidden="true"
        style="background-color:#333; position:absolute; top:0px; left:0px; width:100%; height:100%; z-index:2000;">
    </div>
    <div class="container">
        <%- include('partials/header', {pageType}) %>
        <%- include('partials/ld-json', {ldJson}) %>
        <main>
            <% if (sections && sections.length > 0) { %>
                <%- include('partials/section-nav') %>
                <% sections.forEach((section, s) => { %>
                    <% var slug = section.name.replace(/[^a-zA-Z0-9]/g, '-').replace(/-+/g, '-').toLowerCase(); %>
                    <section class="beer-section" id="<%= slug %>">
                        <h2 class="section-header"><%= section.name %></h2>
                        <div class="grid">
                            <% section.beers.forEach((beer, i) => { %>
                                <%- include('partials/snippet', {item: beer, eager: s === 0 && i < eagerImages}); %>
                            <% }) %>
                        </div>
                    </section>
                <% }) %>
            <% } else { %>
                <p><%= t('bottles.empty') %></p>
            <% } %>
        </main>
    </div>
    <%- include('partials/footer') %>
    <div style="display: none;"><%= buildDate.toUTCString() %></div>
</body>

</html>
