<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%# Internal preview index: never indexed, links never followed %>
    <meta name="robots" content="noindex, nofollow">
    <title>Beersheep menu — design previews</title>
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #231f20; color: #f5f5f5; font: 16px/1.5 system-ui, sans-serif; max-width: 860px; margin: 0 auto; padding: 32px 16px; }
        h1 { font-size: 1.6rem; margin-bottom: 4px; }
        .lead { color: #aaa; margin-bottom: 28px; }
        .lead a, .themes a { color: #4dac68; }
        .themes { list-style: none; display: grid; gap: 14px; }
        .theme { display: flex; gap: 16px; align-items: center; padding: 14px; border: 1px solid #3a3a3a; border-radius: 6px; }
        .swatch { width: 56px; height: 56px; flex-shrink: 0; border-radius: 4px; border: 1px solid #555; }
        .theme h2 { font-size: 1.15rem; }
        .theme p { color: #aaa; font-size: 0.92rem; }
        .links { display: flex; gap: 14px; margin-top: 4px; font-size: 0.92rem; }
        footer { margin-top: 32px; color: #777; font-size: 0.82rem; }
    </style>
</head>

<body>
    <h1>Design previews</h1>
    <p class="lead">Same pages and data as the <a href="/">live menu</a>, restyled.</p>
    <ul class="themes">
        <% themes.forEach(function(theme, i) { %>
        <li class="theme">
            <div class="swatch" style="background: <%= theme.color %>"></div>
            <div>
                <h2><%= i + 1 %>. <%= theme.name %></h2>
                <p><%= theme.desc %></p>
                <div class="links">
                    <a href="/beta/<%= theme.slug %>/">On Tap</a>
                    <a href="/beta/<%= theme.slug %>/bottles/">Bottles &amp; Cans</a>
                    <% if (hasStore) { %><a href="/beta/<%= theme.slug %>/store/">Beer Store</a><% } %>
                </div>
            </div>
        </li>
        <% }) %>
    </ul>
    <footer>Built <%= buildDate.toUTCString() %></footer>
</body>

</html>
