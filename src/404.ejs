<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <%# Must come first: browsers only look for the charset in the first 1024 bytes %>
    <meta charset="utf-8">
    <% if (process.env.NODE_ENV === 'production') { %>
        <%- partials.gtag %>
        <%- partials.cftag %>
    <% } %>
    <link rel="stylesheet" href="/styles.css" fetchpriority="high">
    <link rel="prefetch" href="<%= base %>/bottles/" as="document">
    <%- include('partials/head', {pageType: '404'}) %>
</head>

<body>
    <%- iconSprite %>
    <div class="container">
        <%- include('partials/header', {pageType: '404'}) %>
        <main>
            <div class="not-found">
                <div class="not-found-icon">
                    <%- icon('beer') %>
                </div>
                <h2><%= t('notFound.heading') %></h2>
                <p><%= t('notFound.line1') %></p>
                <p><%= t('notFound.line2') %></p>
                <a href="<%= base %>/" class="not-found-link"><%= t('notFound.back') %></a>
            </div>
        </main>
    </div>
    <%- include('partials/footer') %>
</body>

</html>
